@page
@model MoneyMate.Pages.Account.IndexModel
@{ ViewData["Title"] = "내 계정"; }
<section class="account-overview">
    <span class="eyebrow">MY MONEYMATE</span><h1>@Model.CurrentUser.DisplayName 님,<br /><span>가계부를 시작할 준비가 됐어요.</span></h1>
    <p class="overview-description">로그인한 내 계정의 정보입니다.</p>
    <div class="profile-card"><h2>내 계정</h2><dl><dt>이름</dt><dd>@Model.CurrentUser.DisplayName</dd><dt>이메일</dt><dd>@Model.CurrentUser.Email</dd><dt>가입일</dt><dd>@TimeZoneInfo.ConvertTimeBySystemTimeZoneId(Model.CurrentUser.CreatedAt, "Asia/Seoul").ToString("yyyy-MM-dd")</dd></dl></div>
</section>

