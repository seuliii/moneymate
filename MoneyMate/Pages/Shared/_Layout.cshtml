<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>@ViewData["Title"] · MoneyMate AI</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/transactions.css" asp-append-version="true" />
</head>
<body>
    <header class="header">
        <a class="brand" asp-page="/Index"><span class="brand-icon" aria-hidden="true">M</span> MoneyMate <span class="ai">AI</span></a>
        <nav class="account-nav" aria-label="계정 메뉴">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-page="/Transactions/Index">거래</a>
            <a class="account-link" asp-page="/Account/Index">@(User.FindFirst("display_name")?.Value ?? "내 계정") 님</a>
            <form method="post" asp-page="/Account/Logout"><button class="nav-button" type="submit">로그아웃</button></form>
        }
        else
        {
            <a asp-page="/Account/Login">로그인</a><a class="nav-register" asp-page="/Account/Register">회원가입</a>
        }
        </nav>
    </header>
    <main id="main">@RenderBody()</main>
    <footer>MoneyMate AI <span>기록에서 시작하는 소비 관리</span></footer>
</body>
</html>

