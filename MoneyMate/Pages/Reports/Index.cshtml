@page
@model MoneyMate.Pages.Reports.IndexModel
@{ ViewData["Title"] = "소비 리포트"; }
<section class="dashboard-page reports-page">
    <span class="eyebrow">MY CONSUMPTION REPORT</span><h1>기록을 돌아보는 소비 리포트</h1>
    <p class="dashboard-note">@(Model.IsMock ? "현재는 연결 확인용 모의 리포트입니다. 외부 AI로 데이터를 전송하지 않습니다." : "분석을 요청하면 소비 통계가 외부 분석 서비스로 전달됩니다. 이름·이메일·거래 내용·메모는 전송하지 않습니다.")</p>
    <form method="get" class="month-picker"><label for="report-month">조회 월</label><input id="report-month" name="month" value="@Model.Month" type="month" max="@Model.CurrentMonth" required /><button class="secondary">조회</button></form>
    @if (TempData["ReportMessage"] is string notice) { <p class="notice" role="status">@notice</p> }
    @if (Model.Message is { } error) { <p class="validation" role="alert">@error</p> }
    <form method="post" class="report-request"><input type="hidden" name="Month" value="@Model.Month" /><button class="primary" type="submit">@(Model.IsMock ? "모의 리포트 생성 / 갱신" : "분석 요청 / 갱신")</button><p class="dashboard-note">하루 분석 시도 한도를 적용합니다. 같은 거래 버전·날짜·설정의 저장 결과는 한도 차감 없이 재사용합니다.</p></form>
    @if (Model.Saved is { } saved)
    {
        ViewData["ReportInput"] = saved.Input;
        <div class="report-meta"><span class="badge">@(saved.Mode == "mock" ? "모의 리포트 · 실제 AI 아님" : "분석 서비스 리포트")</span><span>@saved.GeneratedAt.ToOffset(TimeSpan.FromHours(9)).ToString("yyyy-MM-dd HH:mm") 생성 · 기준일 @saved.AsOfDate.ToString("yyyy-MM-dd")</span></div>
        @if (saved.NeedsRefresh) { <p class="notice" role="status">재분석이 필요합니다. @string.Join(" ", saved.RefreshReasons) 기존 결과를 최신 분석으로 해석하지 마세요.</p> }
        <div class="summary-grid"><article class="stat-card"><span>분석 당시 수입</span><strong>@saved.Input.Facts.Single(x => x.Id == "income.total").Value?.ToString("N0")원</strong></article><article class="stat-card"><span>분석 당시 지출</span><strong>@saved.Input.Facts.Single(x => x.Id == "expense.total").Value?.ToString("N0")원</strong></article><article class="stat-card"><span>분석 당시 월간 수지</span><strong>@saved.Input.Facts.Single(x => x.Id == "net.total").Value?.ToString("N0")원</strong></article></div>
        <section class="dashboard-card"><h2>월간 요약</h2><partial name="_Statement" model="saved.Report.Summary" /></section>
        @foreach (var reportSection in new[] { ("주요 소비 특징", saved.Report.Highlights), ("확인할 소비 변화", saved.Report.ChangesToReview), ("소비 개선 제안", saved.Report.Suggestions) }) {
            <section class="dashboard-card"><h2>@reportSection.Item1</h2>@if (reportSection.Item2.Count == 0) { <p class="dashboard-note">추가 항목이 없습니다.</p> } @foreach (var item in reportSection.Item2) { <partial name="_Statement" model="item" /> }</section>
        }
        <section class="dashboard-card"><h2>분석의 범위와 한계</h2><ul>@foreach (var limit in saved.Input.Limitations) { <li>@limit</li> }</ul><p class="dashboard-note">AI 문장의 사실성까지 근거 ID만으로 보장할 수 없습니다. 수치는 통계 화면과 함께 확인해주세요.</p></section>
    }
    else { <section class="dashboard-card"><h2>저장된 리포트가 없습니다.</h2><p>거래를 기록한 월을 선택하고 리포트를 생성해보세요.</p></section> }
    <a class="secondary" asp-page="/Dashboard/Index" asp-route-month="@Model.Month">현재 통계 확인 →</a>
</section>
<script src="~/js/report-form.js" asp-append-version="true" defer></script>

